# Copy to .env for LOCAL DEV ONLY. Only this .example file is committed.
#
# In dev, Vite serves the UI on :5173 and the API runs separately on :8000 —
# different origins — so point the frontend at the API here:
VITE_API_BASE=http://localhost:8000
#
# In the deployed (combined) build this is left UNSET: FastAPI serves the UI and
# the API from the same origin, so the app uses relative URLs. Vite inlines this
# at build time.
