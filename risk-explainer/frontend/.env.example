# Copy to .env for local dev. Only this .example file is committed.
#
# Base URL of the FastAPI backend. Vite inlines this at BUILD time, so it must
# be set wherever you build:
#   - local dev:  .env in this folder
#   - Render:     wired automatically from the API service by render.yaml
#
# If unset, the app falls back to http://localhost:8000 (a production build with
# no value set will call localhost and fail).
VITE_API_BASE=http://localhost:8000
