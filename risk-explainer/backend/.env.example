# Copy to .env and fill in. Only this .example file is committed.

# Required: your Groq API key. Get one (free, no credit card) at
# https://console.groq.com/keys
# Without it the app still runs, but /explain always returns the safe fallback.
GROQ_API_KEY=

# Database. Defaults to a local SQLite file. For any real deployment use a
# managed Postgres — e.g. postgres://USER:PASS@HOST:5432/DBNAME
# ("postgres://" / "postgresql://" URLs are auto-normalised to the psycopg driver).
# DATABASE_URL=sqlite:///./risk_explainer.db

# The deployed build serves the UI from this same origin, so CORS isn't needed
# there. localhost is always allowed (for local dev). Set this only if you host a
# frontend on a different origin, e.g.
# CORS_ORIGINS=https://riskexplainer.example.com

# Where the built frontend lives, for the combined deployment. The Docker image
# sets this to /app/static; unset locally (main.py falls back to ../frontend/dist
# if it exists, otherwise just serves the API).
# FRONTEND_DIST=/app/static

# Per-IP rate limit on /explain and /whatif (protects the shared Groq quota).
# RATE_LIMIT_MAX_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=60
