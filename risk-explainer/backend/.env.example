# Copy to .env and fill in. Only this .example file is committed.

# Required: your Groq API key. Get one (free, no credit card) at
# https://console.groq.com/keys
# Without it the app still runs, but /explain always returns the safe fallback.
GROQ_API_KEY=

# Database. Defaults to a local SQLite file. For any real deployment use a
# managed Postgres — e.g. postgres://USER:PASS@HOST:5432/DBNAME
# ("postgres://" / "postgresql://" URLs are auto-normalised to the psycopg driver).
# DATABASE_URL=sqlite:///./risk_explainer.db

# Comma-separated list of browser origins allowed to call this API.
# Add your deployed frontend URL here in production, e.g.
# CORS_ORIGINS=https://your-app.vercel.app
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-IP rate limit on /explain and /whatif (protects the shared Groq quota).
# RATE_LIMIT_MAX_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=60
